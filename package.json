{
  "name": "team-slug",
  "version": "0.0.1",
  "license": "CC-BY-4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "build": "yarn codegen && tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "preview": "vite preview",
    "test:e2e": "playwright test --grep-invert @performance",
    "test:e2e:perf": "playwright test tests/fermentation-map.performance.spec.ts"
  },
  "dependencies": {
    "@fatso83/retry-dynamic-import": "2.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "bootstrap": "^5.3.8",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "katex": "^0.18.7",
    "lenis": "^1.3.26",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "6.14.0",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "citation-js": "^0.9.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "packageManager": "yarn@4.18.0"
}
